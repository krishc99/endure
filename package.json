{
  "name": "rundj-phone",
  "version": "0.1.0",
  "description": "Run DJ: cadence-matched music player (test app)",
  "scripts": {
    "bundle": "esbuild src/bridge.js --bundle --format=iife --minify --external:fs --external:path --external:crypto --define:__DEV_SOURCES__=true --outfile=www/bridge.js",
    "bundle:release": "esbuild src/bridge.js --bundle --format=iife --minify --external:fs --external:path --external:crypto --define:__DEV_SOURCES__=false --outfile=www/bridge.js",
    "page": "python3 tools/build_phone.py",
    "build": "npm run bundle && npm run page && cap sync android",
    "build:release": "npm run bundle:release && npm run page && cap sync android",
    "open": "cap open android",
    "run": "cap run android",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "^8.11.12",
    "@capgo/capacitor-pedometer": "^8.0.52",
    "essentia.js": "^0.1.3",
    "rundj-applemusic": "file:plugins/rundj-applemusic",
    "rundj-background": "file:plugins/rundj-background"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true
}
