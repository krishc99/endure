{
  "name": "rundj-phone",
  "version": "0.1.0",
  "description": "Run DJ: cadence-matched music player (test app)",
  "scripts": {
    "bundle": "esbuild src/bridge.js --bundle --format=iife --minify --external:fs --external:path --external:crypto --outfile=www/bridge.js",
    "page": "python3 tools/build_phone.py",
    "build": "npm run bundle && npm run page && cap sync android",
    "open": "cap open android",
    "run": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capgo/capacitor-health": "^8.11.12",
    "@capgo/capacitor-pedometer": "^8.0.52",
    "essentia.js": "^0.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true
}
